@@ -0,0 +1,22 @@
+import { PickingService } from "./picking.js";
+import { ShippingService } from "./shipping.js";
+import type { Order } from "../types.js";
+
+export { PickingService } from "./picking.js";
+export { ShippingService } from "./shipping.js";
+
+/**
+ * Picking and shipping used to live in one class that did both. They are now
+ * two services; this composes them so callers don't have to change yet.
+ */
+export class FulfilmentService {
+  constructor(
+    private readonly picking = new PickingService(),
+    private readonly shipping = new ShippingService(),
+  ) {}
+
+  async fulfil(order: Order): Promise<void> {
+    const picked = await this.picking.pick(order);
+    await this.shipping.book(order, picked);
+  }
+}
