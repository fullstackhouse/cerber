@@ -0,0 +1,24 @@
+import { warehouse } from "../../lib/warehouse.js";
+import { logger } from "../../lib/logger.js";
+import type { Order, PickedItem } from "../types.js";
+
+export class PickingService {
+  async pick(order: Order): Promise<PickedItem[]> {
+    const picked: PickedItem[] = [];
+    for (const line of order.lines) {
+      const stock = await warehouse.reserve(line.sku, line.quantity);
+      if (!stock) {
+        logger.warn({ sku: line.sku, order: order.id }, "out of stock");
+        continue;
+      }
+      picked.push({ sku: line.sku, quantity: line.quantity, bin: stock.bin });
+    }
+    return picked;
+  }
+
+  async unpick(items: PickedItem[]): Promise<void> {
+    for (const item of items) {
+      await warehouse.release(item.sku, item.quantity);
+    }
+  }
+}
