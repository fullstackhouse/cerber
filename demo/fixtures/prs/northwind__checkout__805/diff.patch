+import { courier } from "../../lib/courier.js";
+import type { Order, PickedItem } from "../types.js";
+
+export class ShippingService {
+  async book(order: Order, items: PickedItem[]): Promise<void> {
+    if (items.length === 0) return;
+    const label = await courier.createLabel({
+      address: order.shippingAddress,
+      parcels: items.map((i) => ({ sku: i.sku, quantity: i.quantity })),
+    });
+    await courier.dispatch(label.id);
+  }
+}
