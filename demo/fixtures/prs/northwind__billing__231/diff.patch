@@ -1,13 +1,22 @@
 import type { InvoiceLine, Money } from "./types.js";
 import { addMoney, multiply, zero } from "../lib/money.js";
 
+/** Round to the nearest minor unit, halves away from zero. */
+function roundMinor(value: number): number {
+  return Math.sign(value) * Math.round(Math.abs(value));
+}
+
 export function lineNet(line: InvoiceLine): Money {
   return multiply(line.unitPrice, line.quantity);
 }
 
+export function lineVat(line: InvoiceLine): Money {
+  const net = lineNet(line);
+  return { currency: net.currency, minor: roundMinor(net.minor * line.vatRate) };
+}
+
 export function invoiceTotals(lines: InvoiceLine[], currency: string) {
   const net = lines.reduce((sum, l) => addMoney(sum, lineNet(l)), zero(currency));
-  const vatRate = lines[0]?.vatRate ?? 0;
-  const vat = { currency, minor: Math.round(net.minor * vatRate) };
+  const vat = lines.reduce((sum, l) => addMoney(sum, lineVat(l)), zero(currency));
   return { net, vat, gross: addMoney(net, vat) };
 }
