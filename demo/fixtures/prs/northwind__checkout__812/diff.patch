 import { capturePayment, refundPayment } from "./capture.js";
 import { StripeEvent } from "./types.js";
+import { RetriesExhausted, withBackoff } from "./retry-queue.js";
 
 /**
  * Payment intents we are working on right now. A second delivery of the same
@@ -8,29 +9,42 @@ import { StripeEvent } from "./types.js";
  */
 const inFlight = new Set<string>();
 
+async function processWithRetry(event: StripeEvent): Promise<void> {
+  await withBackoff({
+    name: `webhook:${event.data.object.id}`,
+    run: () => dispatch(event),
+  });
+}
+
 export async function handleWebhook(event: StripeEvent): Promise<void> {
   const intentId = event.data.object.id;
   if (inFlight.has(intentId)) {
     logger.info({ intent: intentId }, "webhook already in flight, ignoring");
     return;
   }
   inFlight.add(intentId);
   try {
-    await dispatch(event);
+    await processWithRetry(event);
+  } catch (err) {
+    if (err instanceof RetriesExhausted) {
+      logger.error({ err, intent: intentId }, "webhook gave up after retries");
+      return;
+    }
+    throw err;
   } finally {
     inFlight.delete(intentId);
   }
 }
 
 async function dispatch(event: StripeEvent): Promise<void> {
   switch (event.type) {
     case "payment_intent.requires_capture":
       await capturePayment(event.data.object);
       break;
     case "charge.refunded":
       await refundPayment(event.data.object);
       break;
     default:
       logger.debug({ type: event.type }, "webhook type not handled");
   }
 }
