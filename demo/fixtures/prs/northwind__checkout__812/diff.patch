diff --git a/src/payments/retry-queue.ts b/src/payments/retry-queue.ts
new file mode 100644
index 0000000..7c31f9a
--- /dev/null
+++ b/src/payments/retry-queue.ts
@@ -0,0 +1,47 @@
+import { setTimeout as delay } from "node:timers/promises";
+import { logger } from "../lib/logger.js";
+
+const BASE_DELAY_MS = 500;
+const MAX_ATTEMPTS = 5;
+
+export interface RetryTask<T> {
+  /** Identifies the task in the retry logs. */
+  name: string;
+  run: () => Promise<T>;
+}
+
+export class RetriesExhausted extends Error {
+  constructor(
+    readonly task: string,
+    readonly attempts: number,
+    readonly cause: unknown,
+  ) {
+    super(`${task} failed after ${attempts} attempts`);
+  }
+}
+
+/**
+ * Run a task, retrying failures with exponential backoff and full jitter.
+ *
+ * Stripe gives up on a webhook after a few days of its own retries, which is
+ * far longer than we can hold a request open — so transient failures (a lock
+ * timeout, a blip talking to the ledger) are retried here instead of bouncing
+ * back to Stripe and waiting an hour for the next delivery.
+ */
+export async function withBackoff<T>(task: RetryTask<T>): Promise<T> {
+  let lastError: unknown;
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+    try {
+      return await task.run();
+    } catch (err) {
+      lastError = err;
+      const wait = Math.round(Math.random() * BASE_DELAY_MS * 2 ** (attempt - 1));
+      logger.warn(
+        { task: task.name, attempt, wait, err },
+        "task failed, retrying after backoff",
+      );
+      await delay(wait);
+    }
+  }
+  throw new RetriesExhausted(task.name, MAX_ATTEMPTS, lastError);
+}
