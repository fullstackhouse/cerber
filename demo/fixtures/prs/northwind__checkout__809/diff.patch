@@ -12,6 +12,18 @@ export interface AppliedPromo {
   amountOff: Money;
 }
 
+/**
+ * How a promo should read on the summary line: "SPRING25 — 25% off" for a
+ * percentage code, "WELCOME10 — £10 off" for a fixed one.
+ */
+export function describePromo(promo: AppliedPromo): string {
+  const off =
+    promo.kind === "percentage"
+      ? `${promo.percentOff}% off`
+      : `${formatMoney(promo.amountOff)} off`;
+  return `${promo.code} — ${off}`;
+}
+
 export function totalDiscount(promos: AppliedPromo[]): Money {
   return promos.reduce((sum, p) => addMoney(sum, p.amountOff), zero(promos[0].amountOff.currency));
 }
